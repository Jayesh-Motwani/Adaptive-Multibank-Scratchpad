read_verilog rtl/sync_ram.v rtl/mac_engine.v rtl/scratchpad_controller.v
chparam -set POLICY 2 -set NUMBER_OF_TILES 64 -set ADDR_WIDTH 2 -set LOOKAHEAD_LOAD 0 -set LOOKAHEAD_COMPUTE 0 scratchpad_controller
synth -top scratchpad_controller -flatten
write_json results/netlist/lookahead_legacy_fixed4_gate.json
write_verilog -noattr results/netlist/lookahead_legacy_fixed4_gate.v
stat
